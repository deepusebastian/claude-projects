{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "functions": {
    "src/app/api/news/route.ts": { "maxDuration": 30 },
    "src/app/api/models/route.ts": { "maxDuration": 15 },
    "src/app/api/cron/refresh-news/route.ts": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/cron/refresh-news",
      "schedule": "0 */6 * * *"
    }
  ]
}
